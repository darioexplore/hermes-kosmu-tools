{
  "name": "hermes-kosmu-tools",
  "version": "1.0.0",
  "private": true,
  "description": "Hermes agent tool definitions for the KOSMU Admin API and Gmail drafts.",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tools.json": "./tools.json"
  },
  "bin": {
    "hermes-kosmu-doctor": "./dist/doctor.js",
    "hermes-kosmu-call": "./dist/call-tool.js"
  },
  "files": ["dist", "tools.json", "workflow", "README.md", "CONNECTOR_PACKET.md", ".env.example"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "googleapis": "^144.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
