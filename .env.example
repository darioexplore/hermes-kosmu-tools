# ─────────────────────────────────────────────────────────────────────
# Hermes -> KOSMU + Gmail integration environment
# Copy to .env (and load it in the Hermes process). Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────

# ── KOSMU Admin Agent API ────────────────────────────────────────────
# Base URL of the KOSMU deployment (no trailing slash).
#   Production:  https://kosmu.vercel.app
#   Local dev:   http://localhost:3000
KOSMU_API_BASE_URL=https://kosmu.vercel.app

# The agent token generated in KOSMU Settings -> Integrations. KOSMU controls
# project access by adding/removing this agent as a collaborator on projects.
KOSMU_AGENT_TOKEN=replace-with-kosmu-settings-token

# ── Gmail (drafts only) ──────────────────────────────────────────────
# A Google Cloud OAuth 2.0 client (Desktop or Web) with the Gmail API enabled.
# Minimal scope:  https://www.googleapis.com/auth/gmail.compose
# (Google has no draft-only-no-send scope; "never send" is enforced in code —
#  this toolset exposes no send path.)
GMAIL_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_OAUTH_CLIENT_SECRET=your-client-secret
# A long-lived refresh token for the account that owns the drafts. Obtain once
# via the OAuth consent flow (offline access), then store it here.
GMAIL_OAUTH_REFRESH_TOKEN=your-refresh-token

# Which mailbox to create drafts in. "me" = the token's own account (typical).
# Set to the account email only for delegated/workspace setups.
GMAIL_ACCOUNT_ID=me
